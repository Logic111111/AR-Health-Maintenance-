# Copy this file to .env and set your MySQL/MariaDB login.
# Everything here can also be set as real environment variables (cloud) - .env is
# only read for local convenience and is never committed.

# MySQL 8 / MariaDB 10.6 (target database):
DATABASE_URL=mysql+pymysql://ar_gen:CHANGE_ME@127.0.0.1:3306/ar_maintenance

# SQLite alternative (no server needed):
# DATABASE_URL=sqlite:///data/ar_maintenance.sqlite

# Optional overrides
# AR_CONFIG=config.yaml
# AR_STATE_DIR=state
# AR_OUTPUT_DIR=output
# AR_LOG_DIR=logs
